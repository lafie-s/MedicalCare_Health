{
  "profile": "product-admin",
  "sourceRoots": ["web/app", "web/components"],
  "locale": "zh-CN",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Form", "Scrollbar", "Select/Listbox", "Date"],
  "ownership": { "Select/Listbox": "native", "Date": "native" },
  "requiredCommands": ["typecheck", "tokens"],
  "commands": { "typecheck": "npm run typecheck --prefix web", "tokens": "npm run tokens:check" }
}
