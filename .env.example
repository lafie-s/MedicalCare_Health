# PLATFORM_ORIGIN=http://127.0.0.1:4320
# ACCESS_POLICY_PATH=data/access-policy.json
# SESSION_KEY=<base64-encoded-32-random-bytes>
# STATE_DB_PATH=data/health.sqlite
