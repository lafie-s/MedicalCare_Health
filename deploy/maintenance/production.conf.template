# HTTP server context on the public ingress. Render MAINTENANCE_GATE_KEY from a
# secret at deploy time; never commit the rendered configuration.
# The ingress must reach health-api only on a private Docker network.
# Do not include this in the public Health preview server.
location = /_medicalcare_maintenance_check {
    internal;
    proxy_pass http://health-api:4310/internal/maintenance-check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Maintenance-Key "${MAINTENANCE_GATE_KEY}";
    proxy_set_header X-Maintenance-IP $remote_addr;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3s;
}
location = /_medicalcare_maintenance.html {
    internal;
    alias /etc/nginx/maintenance/maintenance.html;
    add_header Cache-Control "no-store" always;
    add_header Retry-After "60" always;
    add_header X-Content-Type-Options nosniff always;
}
